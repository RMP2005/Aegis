# Aegis Environment Configuration
# Copy this file to .env and fill in values.

# ============================================
# BACKEND
# ============================================

# OpenAI API key for AI-powered analysis (optional)
# Without this, the system uses built-in mock analysis with pre-written explanations.
OPENAI_API_KEY=

# CORS allowed origins (comma-separated)
# In production, set this to your frontend URL(s).
# Example: https://aegis-frontend.vercel.app
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Enable Swagger/ReDoc docs at /docs (set to "false" in production)
ENABLE_DOCS=true

# Reports directory (defaults to ./reports)
REPORTS_DIR=

# ============================================
# FRONTEND
# ============================================

# Backend API URL (must be prefixed with NEXT_PUBLIC_ for client-side access)
# In production, set this to your deployed backend URL.
# Example: https://aegis-backend.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:8000

# ============================================
# DEPLOYMENT EXAMPLES
# ============================================

# Railway / Render (backend):
#   OPENAI_API_KEY=sk-...
#   CORS_ORIGINS=https://your-frontend.vercel.app
#   ENABLE_DOCS=false
#   PORT=8000  (set automatically by platform)

# Vercel (frontend):
#   NEXT_PUBLIC_API_URL=https://your-backend.onrender.com
