# Aegis Environment Configuration

# Backend
# OpenAI API key for AI-powered analysis (optional, falls back to mock analysis)
OPENAI_API_KEY=

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Enable Swagger/ReDoc docs (set to "false" in production)
ENABLE_DOCS=true

# Reports directory (defaults to ./reports)
REPORTS_DIR=

# Frontend
# Backend API URL (must be prefixed with NEXT_PUBLIC_ for client-side access)
NEXT_PUBLIC_API_URL=http://localhost:8000
